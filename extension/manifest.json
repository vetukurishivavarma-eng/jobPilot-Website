{
  "manifest_version": 3,
  "name": "JobPilot Autofill",
  "version": "0.2.0",
  "description": "Fills the application JobPilot prepared, in your own browser. With auto mode on, works through the ready ones one tab at a time. CAPTCHAs are always left to you.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["http://localhost:8080/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://jobs.lever.co/*", "https://jobs.eu.lever.co/*", "https://*.greenhouse.io/*"],
      "js": ["fill.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["token.js"],
      "run_at": "document_idle"
    }
  ]
}
