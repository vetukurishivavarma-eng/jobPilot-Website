{
  "name": "jobpilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "tsc -b && node -e \"require('fs').rmSync('../backend/src/main/resources/static/assets',{recursive:true,force:true})\" && vite build --outDir ../backend/src/main/resources/static",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.8",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
